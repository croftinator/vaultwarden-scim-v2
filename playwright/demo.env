####################################################################
### Demo seeder configuration - see docs/scim/demo-plan.md        ###
####################################################################
#
# These are DEMO credentials for a local throwaway sandbox that is not
# reachable from anywhere. They are committed on purpose, because a demo whose
# password you have to be told is a demo that does not work unattended, and
# because the walkthrough has to print them on screen anyway.
#
# That reasoning does NOT extend to anything the sandbox generates - the
# ADMIN_TOKEN, the SCIM token and the OIDC client secret are all generated at
# run time and live outside the repository. See CLAUDE.md rule 4.

# Where the sandbox is. Must match DOMAIN in the sandbox .env, because the web
# vault refuses to talk to an origin it was not built to serve.
DEMO_DOMAIN=https://localhost:8000

# The Owner. Everything in the demo is created by this account, and it is the
# one the presenter signs in as.
DEMO_OWNER_NAME="Demo Owner"
DEMO_OWNER_MAIL=owner@example.com
DEMO_OWNER_PASSWORD=demo-master-password-1

# The organization SCIM provisions into.
DEMO_ORG_NAME="Example Corp"

# The provisioned member the walkthrough takes all the way to Confirmed. Must
# match a user in tools/authentik/blueprints/demo-directory.yaml, because SCIM
# creates the membership and this account claims it by accepting the invite.
DEMO_MEMBER_NAME="Ada Lovelace"
DEMO_MEMBER_MAIL=ada.lovelace@example.com
DEMO_MEMBER_PASSWORD=demo-master-password-2
# Ada's password in AUTHENTIK - distinct from her Vaultwarden master password
# above, and that distinction is the point: SSO proves who she is, the master
# password derives her vault key. The demo would be misleading if they matched.
#
# Set at run time by tools/scim-demo.sh rather than written into the blueprint,
# so the directory definition stays free of credentials.
DEMO_MEMBER_SSO_PASSWORD=demo-sso-password-2

# Mailpit, from tools/local-stack/docker-compose.yml. The seeder reads the
# invite from here rather than guessing the accept URL.
DEMO_MAILPIT_URL=http://localhost:8025
